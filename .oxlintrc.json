{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "React": "readonly"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".output",
    ".nitro",
    ".tanstack",
    "src/app/routeTree.gen.ts"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "settings": {
    "react": {
      "version": "19.0.0"
    }
  },
  "jsPlugins": ["./tools/oxlint-plugin-boundaries/index.js"],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "boundaries/no-cross-feature-imports": "error",
    "react/react-in-jsx-scope": "off",
    "react/button-has-type": "error",
    "react/jsx-no-target-blank": "error",
    "react/self-closing-comp": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-explicit-any": "off"
      }
    }
  ]
}
