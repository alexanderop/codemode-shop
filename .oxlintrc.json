{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {
    "React": "readonly"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".output",
    ".nitro",
    ".tanstack",
    "src/routeTree.gen.ts"
  ],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-explicit-any": "off"
      }
    }
  ]
}
